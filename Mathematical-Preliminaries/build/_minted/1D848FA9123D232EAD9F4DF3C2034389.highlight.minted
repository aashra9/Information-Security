        \PYG{n}{Li} \PYG{o}{=} \PYG{n}{num} \PYG{o}{*} \PYG{n}{modinv}\PYG{p}{(}\PYG{n}{den}\PYG{p}{)} \PYG{o}{\PYGZpc{}} \PYG{n}{p}
