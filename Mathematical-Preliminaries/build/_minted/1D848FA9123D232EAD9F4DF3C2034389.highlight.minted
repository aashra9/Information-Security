    \PYG{k}{return} \PYG{n}{result}

\PYG{c+c1}{\PYGZsh{} Reconstruct secret from shares (Shamir\PYGZsq{}s scheme, t=3)}
\PYG{n}{shares} \PYG{o}{=} \PYG{p}{[(}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{5}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{),} \PYG{p}{(}\PYG{l+m+mi}{3}\PYG{p}{,} \PYG{l+m+mi}{4}\PYG{p}{)]}  \PYG{c+c1}{\PYGZsh{} (x\PYGZus{}i, y\PYGZus{}i), p=17}
