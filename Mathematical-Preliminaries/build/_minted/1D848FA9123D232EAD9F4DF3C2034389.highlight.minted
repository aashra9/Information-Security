\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{lagrange\PYGZus{}interpolate}\PYG{p}{(}\PYG{n}{points}\PYG{p}{,} \PYG{n}{x}\PYG{p}{,} \PYG{n}{p}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Evaluate the interpolating polynomial at x over Z\PYGZus{}p.}
\PYG{l+s+sd}{    points: list of (x\PYGZus{}i, y\PYGZus{}i) tuples with distinct x\PYGZus{}i.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{modinv}\PYG{p}{(}\PYG{n}{a}\PYG{p}{):}
        \PYG{k}{return} \PYG{n+nb}{pow}\PYG{p}{(}\PYG{n}{a}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{p}\PYG{p}{)}

    \PYG{n}{result} \PYG{o}{=} \PYG{l+m+mi}{0}
    \PYG{k}{for} \PYG{n}{i}\PYG{p}{,} \PYG{p}{(}\PYG{n}{xi}\PYG{p}{,} \PYG{n}{yi}\PYG{p}{)} \PYG{o+ow}{in} \PYG{n+nb}{enumerate}\PYG{p}{(}\PYG{n}{points}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} Compute L\PYGZus{}i(x)}
        \PYG{n}{num}\PYG{p}{,} \PYG{n}{den} \PYG{o}{=} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{1}
        \PYG{k}{for} \PYG{n}{j}\PYG{p}{,} \PYG{p}{(}\PYG{n}{xj}\PYG{p}{,} \PYG{n}{\PYGZus{}}\PYG{p}{)} \PYG{o+ow}{in} \PYG{n+nb}{enumerate}\PYG{p}{(}\PYG{n}{points}\PYG{p}{):}
            \PYG{k}{if} \PYG{n}{i} \PYG{o}{!=} \PYG{n}{j}\PYG{p}{:}
