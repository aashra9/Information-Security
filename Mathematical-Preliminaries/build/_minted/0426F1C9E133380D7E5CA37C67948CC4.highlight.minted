\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{rs\PYGZus{}encode}\PYG{p}{(}\PYG{n}{msg}\PYG{p}{,} \PYG{n}{alpha}\PYG{p}{,} \PYG{n}{q}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Encode a message using a Reed\PYGZhy{}Solomon code over GF(q).}
\PYG{l+s+sd}{    msg: list of field elements (as integers) of length k.}
\PYG{l+s+sd}{    alpha: list of n distinct evaluation points.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{k} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{msg}\PYG{p}{)}
    \PYG{n}{n} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{alpha}\PYG{p}{)}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{eval\PYGZus{}poly}\PYG{p}{(}\PYG{n}{coeffs}\PYG{p}{,} \PYG{n}{x}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} Horner\PYGZsq{}s method over GF(q)}
        \PYG{n}{result} \PYG{o}{=} \PYG{l+m+mi}{0}
        \PYG{k}{for} \PYG{n}{c} \PYG{o+ow}{in} \PYG{n+nb}{reversed}\PYG{p}{(}\PYG{n}{coeffs}\PYG{p}{):}
            \PYG{n}{result} \PYG{o}{=} \PYG{p}{(}\PYG{n}{result} \PYG{o}{*} \PYG{n}{x} \PYG{o}{+} \PYG{n}{c}\PYG{p}{)} \PYG{o}{\PYGZpc{}} \PYG{n}{q}
        \PYG{k}{return} \PYG{n}{result}

    \PYG{k}{return} \PYG{p}{[}\PYG{n}{eval\PYGZus{}poly}\PYG{p}{(}\PYG{n}{msg}\PYG{p}{,} \PYG{n}{a}\PYG{p}{)} \PYG{k}{for} \PYG{n}{a} \PYG{o+ow}{in} \PYG{n}{alpha}\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} RS(7, 3) over GF(7): n=7 evaluation points, k=3 message symbols}
\PYG{n}{q}\PYG{p}{,} \PYG{n}{alpha} \PYG{o}{=} \PYG{l+m+mi}{7}\PYG{p}{,} \PYG{n+nb}{range}\PYG{p}{(}\PYG{l+m+mi}{7}\PYG{p}{)}
\PYG{n}{msg} \PYG{o}{=} \PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{]}  \PYG{c+c1}{\PYGZsh{} message polynomial: 1 + 2x + 3x\PYGZca{}2}
\PYG{n}{codeword} \PYG{o}{=} \PYG{n}{rs\PYGZus{}encode}\PYG{p}{(}\PYG{n}{msg}\PYG{p}{,} \PYG{n}{alpha}\PYG{p}{,} \PYG{n}{q}\PYG{p}{)}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Codeword: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{codeword}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
